+        </div>
+
+        <label className="flex items-center gap-2 mb-3 text-[11px]" style={{ color: 'var(--ink-3)' }}>
+          <input type="checkbox" checked={whatsapp} onChange={(e) => setWhatsapp(e.target.checked)} />
