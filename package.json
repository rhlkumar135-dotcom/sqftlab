{
  "name": "sqftlab",
  "version": "1.0.0",
  "private": true,
  "description": "sqftLab - UAE Property Intelligence Platform",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun --watch run server.tsx",
    "dev:client": "vite",
    "build": "vite build",
    "start": "bash scripts/railway-setup.sh",
    "generate": "bun ./node_modules/@shogo-ai/sdk/bin/cli.mjs generate",
    "postgenerate": "bun run scripts/fix-server-order.ts || true",
    "_comment_postgenerate": "Only fires for a MANUAL `bun run generate`. The in-editor regeneration calls the SDK CLI directly and skips it — verified, see scripts/fix-server-order.ts.",
    "db:generate": "bun x --bun prisma generate",
    "db:migrate:deploy": "bun x --bun prisma migrate deploy",
    "db:push": "bun x --bun prisma db push",
    "db:studio": "bun x --bun prisma studio",
    "postinstall": "if [ -z \"$RAILWAY_ENVIRONMENT\" ]; then bun x prisma generate; fi",
    "railway:setup": "bash scripts/railway-setup.sh"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "^7.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.3.0",
    "@prisma/pg-worker": "^6.9.0",
    "@shogo-ai/sdk": "^1.10.0",
    "@stripe/stripe-js": "^10.0.0",
    "@types/leaflet": "^1.9.22",
    "ai": "^6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "framer-motion": "^13.4.2",
    "hono": "^4.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.563.0",
    "mobx": "^6.13.0",
    "mobx-react-lite": "^4.0.0",
    "pg": "^8.23.0",
    "puppeteer-core": "^25.12.0",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.3",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@prisma/internals": "^7.3.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^8.2.0",
    "postcss": "^8.5.6",
    "prisma": "^7.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.0.0"
  }
}
