# Keep host artifacts out of the image.
#
# node_modules must never be copied in: the host's native binaries (prisma
# engines, libsql) are built for this sandbox's platform, and baking them into the
# image produces runtime "invalid ELF header" failures that look like app bugs.
# Dependencies are installed inside the image by scripts/railway-build.sh instead.
node_modules
dist
.git
.gitignore
.env
.env.*
*.log

# Regenerated by railway-build.sh — a stale host copy would shadow the fresh one.
src/generated

# Local SQLite database. The container gets a real DATABASE_URL or its own copy.
prisma/dev.db
prisma/dev.db-journal
