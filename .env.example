# Database (Railway auto-sets DATABASE_URL when you add PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/sqftlab"

# Node environment
NODE_ENV=production

# Port (Railway sets this automatically)
PORT=3001

# ── Hourly data refresh ───────────────────────────────────────────────────────
# Secret for POST/GET /api/sqftlab/cron/hourly (and the legacy /scrape and
# /detect-deals endpoints). Generate with: openssl rand -hex 24
#
# Set this in Railway. The app falls back to the old hardcoded value when it is
# unset — that value is committed in this public repo, so it is not a secret and
# should be treated as compromised.
CRON_SECRET=

# Optional: the data providers below are what make the numbers government-sourced
# rather than asking prices. Everything degrades gracefully without them — an
# unconfigured source is reported as "skipped", never filled in with estimates.

# Dubai Land Department via Dubai Pulse (FREE self-serve registration)
# https://dubaipulse.gov.ae → developer access → emails you the key
# DUBAI_PULSE_API_KEY=
# DUBAI_PULSE_BASE=https://api.dubaipulse.gov.ae/open/dld
# DUBAI_PULSE_RESOURCE=dld_transactions-open-api

# ADREC (Abu Dhabi Real Estate Centre). No self-serve open API — access is
# granted by request: https://adrec.gov.ae/en/apisubscription
# The response mapping in src/lib/adrec.ts is tolerant but UNVERIFIED against a
# real payload; check it once credentials arrive.
# ADREC_API_URL=
# ADREC_API_KEY=

# Off by default. When true, railway-setup.sh loads scripts/seed-pg.ts, which
# GENERATES listings and transactions with Math.random() and labels them with
# real source names. Only ever enable this for a throwaway demo environment.
SEED_DEMO_DATA=false

# ── Payments ──────────────────────────────────────────────────────────────────
# The payment kill switch. Read by src/lib/payments-server.ts — the single place
# it is defined server-side (src/lib/payments.ts is browser code: it cannot read
# process.env, and a visitor can edit anything the bundle decides anyway).
#
# Must be the literal string "true" to enable anything. Unset, empty, "TRUE" or
# "1" all mean OFF, so the failure mode of a typo is that payments stay disabled.
# While false: /checkout, /subscribe and /create-payment-intent answer 503, and
# the Stripe webhook is acknowledged (200) and dropped, never processed.
PAYMENTS_ENABLED=false

# ── Stripe (Day 5) ────────────────────────────────────────────────────────────
# Leave these unset until you are ready to take money. The server runs fine
# without them: src/lib/stripe.ts builds its client lazily, so a missing key is a
# 503 from the payment routes rather than a crash on boot. `missingStripeEnv()`
# reports exactly which of these are still absent.
#
# Order of activation:
#   1. Create the products/prices in Stripe, then fill the six price IDs below.
#   2. Add the webhook endpoint in Stripe -> /api/stripe/webhook and copy its secret.
#   3. Set PAYMENTS_ENABLED=true last, and only once 1 and 2 are done. It is
#      checked FIRST on every payment route, so it outranks everything else.
#
# Use test-mode keys (sk_test_/pk_test_) to rehearse the flow before going live.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
STRIPE_PRICE_INSTITUTIONAL_MONTHLY=
STRIPE_PRICE_INSTITUTIONAL_ANNUAL=

# Checkout return URLs. Optional: when unset the origin is taken from the request
# (an explicit value is only needed behind a proxy that rewrites Host).
APP_URL=

