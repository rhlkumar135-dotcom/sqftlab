 prisma/schema.prisma                |  28 +++
 scripts/cleanup-junk-communities.ts |  90 +++++++++
 scripts/find-nplus1.py              |  56 ++++++
 scripts/reconcile-scraperlog.ts     |  24 +++
 scripts/verify-day3.ts              |  96 ++++++++++
 src/lib/cron.ts                     |  37 ++++
 src/lib/score-engine.ts             | 283 ++++++++++++++++++++++++++++
 8 files changed, 860 insertions(+), 23 deletions(-)
