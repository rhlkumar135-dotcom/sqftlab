+async function loadResource<T>(url: string, initial: T): Promise<{ data: T; status: number | null }> {
+  try {
+    const userId = await ensureSession()
+    const r = await fetch(url, userId ? { headers: { Authorization: `Bearer ${userId}` } } : undefined)
