-    topGrowth: [...predictions].sort((a, b) => b.projectedChange12m - a.projectedChange12m).slice(0, 5),
+    topMomentum: [...predictions].sort((a, b) => (b.projectedChange6m ?? -Infinity) - (a.projectedChange6m ?? -Infinity)).slice(0, 5),
