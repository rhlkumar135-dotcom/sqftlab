+
+  const cacheKey = `sqftlab:yield:${community.slug}`
+  const cached = readFlowCache<RentalYieldResult>(cacheKey)
+  if (cached) return c.json({ ...cached, cached: true })
+
+  const result = await computeRentalYield(community.slug)
+
