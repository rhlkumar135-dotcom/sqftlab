+  const falling = measuredChanges.filter(n => n < -2).length
 
   return c.json({
     disclaimer: 'Projections are based on historical trend extrapolation only. ' +
@@ -1586,10 +1597,12 @@ app.get('/sqftlab/predictions', async (c) => {
