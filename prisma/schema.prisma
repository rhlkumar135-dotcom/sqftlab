// SHOGO:CUSTOM-START prisma-header
// Managed by Shogo. Do not add a datasource `url` or change the generator `provider` — the database URL is configured in prisma.config.ts (Prisma 7+).
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// SHOGO:CUSTOM-END

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime? @map("email_verified")
  image         String?
  phone         String?
  nationality   String?
  company       String?
  role          String? // agent | developer | investor | analyst | other
  country       String?

  // Subscription. `subscriptionTier` then `subscriptionStatus` are the spec's
  // canonical names; `/sqftlab/me` still returns the tier as `tier` so the
  // existing client is unchanged.
  //
  // `@map("tier")` is deliberate: the Prisma field carries the spec's name while
  // the physical column keeps its original one. Renaming the column would make
  // `prisma db push` drop it and lose every stored tier value — and that cannot
  // be forced here (`--accept-data-loss` is off limits).
  subscriptionTier      String    @default("free") @map("tier") // free | pro | elite | enterprise | institutional
  subscriptionStatus    String    @default("active") @map("subscription_status") // active | trialing | past_due | cancelled | inactive
  subscriptionId        String?   @map("subscription_id")
  subscriptionExpiresAt DateTime? @map("subscription_expires_at")
  trialEndsAt           DateTime? @map("trial_ends_at")
  currentPeriodEnd      DateTime? @map("current_period_end")
  stripeCustomerId      String?   @map("stripe_customer_id")

  // Notification preferences
  emailAlerts     Boolean @default(true) @map("email_alerts")
  whatsappEnabled Boolean @default(false) @map("whatsapp_enabled")
  whatsappPhone   String? @map("whatsapp_phone")
  // JSON array stored as TEXT — SQLite has no Json column type (see the port note below).
  whatsappAreas   String  @default("[]") @map("whatsapp_areas")
  digestFrequency String  @default("daily") @map("digest_frequency") // daily | weekly | none

  // Onboarding
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  tourCompleted       Boolean @default(false) @map("tour_completed")

  // Guest → registered attribution
  guestId String? @map("guest_id")

  // Meta
  lastLoginAt      DateTime? @map("last_login_at")
  lastActiveAt     DateTime? @map("last_active_at")
  registeredVia    String?   @map("registered_via") // google | github | email | magic_link
  ipAtRegistration String?   @map("ip_at_registration")
  referrer         String?
  utmSource        String?   @map("utm_source")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  portfolios   Portfolio[]
  watchlists   Watchlist[]
  alerts       Alert[]
  dealAlerts   DealAlert[]
  subscription Subscription?
  apiKeys      ApiKey[]
  events       UserEvent[]
  sessions     Session[]
  accounts     Account[]

  @@map("users")
}

model Community {
  id                  String   @id @default(cuid())
  slug                String   @unique
  nameEn              String   @map("name_en")
  nameAr              String?  @map("name_ar")
  emirate             String // dubai, abu_dhabi, sharjah
  latitude            Float
  longitude           Float
  medianAedSqft       Float    @map("median_aed_sqft")
  medianAnnualRentAed Float    @default(0) @map("median_annual_rent_aed")
  grossYieldPct       Float    @default(0) @map("gross_yield_pct")
  neighbourhoodScore  Int      @default(0) @map("neighbourhood_score")
  priceChange30d      Float    @default(0) @map("price_change_30d")
  priceChange1y       Float    @default(0) @map("price_change_1y")
  transactionCount30d Int      @default(0) @map("transaction_count_30d")
  totalTransactions   Int      @default(0) @map("total_transactions")
  // Provenance of medianAedSqft: "dld" when derived from the government
  // transaction register, "listing" when it fell back to asking prices.
  psfSource           String   @default("listing") @map("psf_source")
  // Neighbourhood sub-scores (0-10 each)
  scoreSchools        Int      @default(0) @map("score_schools")
  scoreHealthcare     Int      @default(0) @map("score_healthcare")
  scoreMetro          Int      @default(0) @map("score_metro")
  scoreRetail         Int      @default(0) @map("score_retail")
  scoreParks          Int      @default(0) @map("score_parks")
  scoreWorship        Int      @default(0) @map("score_worship")
  updatedAt           DateTime @updatedAt @map("updated_at")

  transactions Transaction[]
  listings     Listing[]
  portfolios   Portfolio[]
  watchlists   Watchlist[]
  alerts       Alert[]
  scores       InvestmentScore[]

  @@map("communities")
}

model Transaction {
  id              String   @id @default(cuid())
  dldId           String   @unique @map("dld_id")
  communityId     String   @map("community_id")
  transactionType String   @map("transaction_type") // sale, mortgage, off_plan_sale
  propertyType    String   @map("property_type") // apartment, villa, townhouse, commercial
  beds            Int
  areaSqft        Float    @map("area_sqft")
  priceAed        Float    @map("price_aed")
  pricePerSqft    Float    @map("price_per_sqft")
  transactionDate DateTime @map("transaction_date")
  registeredAt    DateTime @default(now()) @map("registered_at")
  source          String   @default("dld_dubai")

  // Spec Part 4: fields that power Building Intelligence, Institutional Flow
  // and the Migration Signal. All nullable so the existing rows stay valid.
  buildingName     String? @map("building_name")
  projectName      String? @map("project_name")
  masterProject    String? @map("master_project")
  floorNumber      Int?    @map("floor_number")
  buyerType        String? @map("buyer_type") // individual | corporate
  buyerNationality String? @map("buyer_nationality")

  community Community @relation(fields: [communityId], references: [id])

  @@index([communityId])
  @@index([transactionDate])
  @@index([communityId, transactionDate])
  @@index([buildingName, communityId]) // building profiles
  @@index([buyerType, communityId]) // institutional flow
  @@index([buyerNationality, transactionDate]) // migration signal
  @@index([pricePerSqft])
  @@map("transactions")
}

model Listing {
  id              String   @id @default(cuid())
  // Unique per portal. This is the dedupe key a scrape upserts on, and it was
  // only indexed — so `upsert({ where: { externalId } })` was rejected outright
  // and the scraper could never have run on any database.
  externalId      String   @unique @map("external_id")
  source          String // bayut, propertyfinder, dubizzle
  communityId     String   @map("community_id")
  purpose         String // sale, rent
  propertyType    String   @map("property_type")
  beds            Int
  baths           Int
  areaSqft        Float    @map("area_sqft")
  priceAed        Float    @map("price_aed")
  pricePerSqft    Float    @map("price_per_sqft")
  furnished       String   @default("unfurnished")
  completion      String   @default("ready") // ready, off_plan
  agentName       String?  @map("agent_name")
  agencyName      String?  @map("agency_name")
  trakheesiPermit String?  @map("trakheesi_permit")
  latitude        Float?
  longitude       Float?
  listedAt        DateTime @map("listed_at")
  scrapedAt       DateTime @default(now()) @map("scraped_at")
  isDeal          Boolean  @default(false) @map("is_deal")
  title           String?
  imageUrl        String?  @map("image_url")
  sourceUrl       String?  @map("source_url")

  community Community @relation(fields: [communityId], references: [id])

  alertMatches AlertMatch[]

  @@index([communityId])
  @@index([isDeal])
  @@index([purpose])
  @@index([scrapedAt])
  @@index([priceAed])
  @@map("listings")
}

model Portfolio {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  communityId     String   @map("community_id")
  title           String
  propertyType    String   @map("property_type")
  beds            Int
  areaSqft        Float    @map("area_sqft")
  purchasePrice   Float    @map("purchase_price")
  purchaseDate    DateTime @map("purchase_date")
  currentValue    Float    @default(0) @map("current_value")
  annualRent      Float    @default(0) @map("annual_rent")
  serviceCharge   Float    @default(0) @map("service_charge")
  mortgageBalance Float    @default(0) @map("mortgage_balance")
  mortgageRate    Float    @default(0) @map("mortgage_rate")
  mortgageTerm    Int      @default(0) @map("mortgage_term")

  // Day 8. `buildingName`/`floor`/`unitNumber` identify the unit; `valuedAt` is the
  // provenance marker that matters most — see the note above the portfolio routes.
  buildingName    String?  @map("building_name")
  floor           Int?
  unitNumber      String?  @map("unit_number")
  valuedAt        DateTime? @map("valued_at")
  valuationSource String?  @map("valuation_source")
  valuationComps  Int?     @map("valuation_comps")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id])
  community Community @relation(fields: [communityId], references: [id])

  @@index([userId])
  @@map("portfolios")
}

model Watchlist {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  communityId String   @map("community_id")
  addedAt     DateTime @default(now()) @map("added_at")

  user      User      @relation(fields: [userId], references: [id])
  community Community @relation(fields: [communityId], references: [id])

  @@unique([userId, communityId])
  @@map("watchlists")
}

model Alert {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  communityId    String?  @map("community_id")
  alertType      String   @map("alert_type") // below_market, new_listing, price_drop, yield_target
  thresholdPct   Float    @default(10) @map("threshold_pct")
  yieldTargetPct Float?   @map("yield_target_pct")
  propertyType   String?  @map("property_type")
  beds           Int?
  notifyPush     Boolean  @default(true) @map("notify_push")
  notifyEmail    Boolean  @default(true) @map("notify_email")
  notifyWhatsapp Boolean  @default(false) @map("notify_whatsapp")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id])
  community Community? @relation(fields: [communityId], references: [id])

  @@index([userId])
  @@map("alerts")
}

model Waitlist {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  company      String?
  role         String? // agent | developer | investor | bank | other
  source       String    @default("waitlist_page")
  interestTier String    @default("pro") @map("interest_tier") // pro, elite
  invitedAt    DateTime? @map("invited_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("waitlist")
}

// TASK 12 — Deal Alert Engine
model DealAlert {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  district     String // community slug
  propertyType String?  @map("property_type")
  maxPrice     Float?   @map("max_price")
  minBeds      Int?     @map("min_beds")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  user    User         @relation(fields: [userId], references: [id])
  matches AlertMatch[]

  @@index([userId])
  @@index([active])
  @@index([district])
  @@map("deal_alerts")
}

model AlertMatch {
  id          String    @id @default(cuid())
  alertId     String    @map("alert_id")
  listingId   String    @map("listing_id")
  detectedAt  DateTime  @default(now()) @map("detected_at")
  psfDiscount Float     @map("psf_discount")
  notified    Boolean   @default(false)
  notifiedAt  DateTime? @map("notified_at")

  alert   DealAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  listing Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([alertId, listingId])
  @@index([notified])
  @@index([detectedAt])
  @@map("alert_matches")
}

// TASK 11 — Subscription tiers
model Subscription {
  id         String    @id @default(cuid())
  userId     String    @unique @map("user_id")
  tier       String    @default("free") // free, pro, elite
  stripeId   String?   @map("stripe_id")
  validUntil DateTime? @map("valid_until")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

// ═══════════════════════════════════════════════════════════════════════════
// Spec Part 4 — intelligence models.
// Where the spec targets Postgres these are ported to SQLite: scalar lists and
// Json columns become TEXT, and the Postgres materialized views become cached
// tables recomputed by the intelligence pipeline (see src/server/intelligence).
// ═══════════════════════════════════════════════════════════════════════════

// Rolled-up per-district metrics — replaces the district_summary matview.
model DistrictMetrics {
  id             String   @id @default(cuid())
  district       String // community slug
  city           String   @default("Dubai")
  period         String   @default("30d") // 1d | 7d | 30d | 90d | 365d
  avgPricePsf    Float?   @map("avg_price_psf")
  medianPricePsf Float?   @map("median_price_psf")
  medianPrice    Float?   @map("median_price")
  totalVolume    Int      @default(0) @map("total_volume")
  totalValueAed  Float    @default(0) @map("total_value_aed")
  avgYield       Float?   @map("avg_yield")
  ejariYield     Float?   @map("ejari_yield")
  priceChange1m  Float?   @map("price_change_1m")
  priceChange3m  Float?   @map("price_change_3m")
  priceChange6m  Float?   @map("price_change_6m")
  priceChange12m Float?   @map("price_change_12m")
  momentumScore  Float?   @map("momentum_score")
  listingsCount  Int?     @map("listings_count")
  dealsCount     Int?     @map("deals_count")
  supplyScore    Float?   @map("supply_score")
  calculatedAt   DateTime @default(now()) @map("calculated_at")

  // Deliberately an index, not a unique constraint. This table is append-only
  // (see Task A4): each run ADDS a row so metric history is never destroyed.
  // A unique constraint would make the second run for the same period fail.
  // Readers select the newest row per district — see `latestDistrictMetrics()`.
  @@index([district, period])
  @@index([district])
  @@index([momentumScore])
  @@map("district_metrics")
}

// Spec Part 6.1 — Real Price Index. The canonical AED/sqft number.
model RealPriceIndex {
  id               String   @id @default(cuid())
  district         String
  propertyType     String   @default("All") // Apartment | Villa | All
  bedrooms         Int      @default(-1) // -1 = all bedroom counts
  period           String   @default("daily")
  indexDate        DateTime @map("index_date")
  indexValue       Float    @map("index_value")
  cpiAdjusted      Float?   @map("cpi_adjusted")
  transactionCount Int      @default(0) @map("transaction_count")
  baseDate         DateTime @default(now()) @map("base_date")
  calculatedAt     DateTime @default(now()) @map("calculated_at")

  @@unique([district, propertyType, bedrooms, period, indexDate])
  @@index([district, indexDate])
  @@map("real_price_index")
}

// Spec Part 6.2 — Building Intelligence Profile. The most granular product.
model BuildingProfile {
  id             String @id @default(cuid())
  buildingNameEn String @map("building_name_en")
  communityEn    String @map("community_en")
  district       String

  totalDldUnits  Int?   @map("total_dld_units")
  psfTrend3m     Float? @map("psf_trend_3m")
  psfTrend12m    Float? @map("psf_trend_12m")
  psfVsCommunity Float? @map("psf_vs_community")
  psfVsDistrict  Float? @map("psf_vs_district")

  avgDaysToResale     Float? @map("avg_days_to_resale")
  liquidityScore      Float? @map("liquidity_score")
  transactionCount12m Int?   @map("transaction_count_12m")

  ownerOccupierRatio Float? @map("owner_occupier_ratio")
  buyerHoldRate      Float? @map("buyer_hold_rate")

  ejariDensity      Float? @map("ejari_density")
  avgContractedRent Float? @map("avg_contracted_rent")

  floorPremiumPct     Float? @map("floor_premium_pct")
  floorPremiumSamples Int?   @map("floor_premium_samples")
  floorPremiumR2      Float? @map("floor_premium_r2")

  intelligenceScore Float?    @map("intelligence_score")
  scoreUpdatedAt    DateTime? @map("score_updated_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([buildingNameEn, communityEn])
  @@index([district])
  @@index([intelligenceScore])
  @@index([communityEn])
  @@map("building_profiles")
}

// Spec Part 6.5 — Institutional Flow Tracker (smart money).
model InstitutionalTransaction {
  id             String   @id @default(cuid())
  entityName     String   @map("entity_name")
  entityType     String   @default("unknown") @map("entity_type")
  district       String
  communityEn    String?  @map("community_en")
  buildingNameEn String?  @map("building_name_en")
  unitCount      Int      @default(0) @map("unit_count")
  totalValue     Float    @default(0) @map("total_value")
  avgPsf         Float?   @map("avg_psf")
  firstDate      DateTime @map("first_date")
  lastDate       DateTime @map("last_date")
  transactionIds String?  @map("transaction_ids") // comma-separated
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([district, firstDate])
  @@index([entityName])
  @@map("institutional_transactions")
}

// Spec Part 6.6 — Construction Pipeline Pressure.
model SupplyPipeline {
  id             String   @id @default(cuid())
  district       String
  expectedUnits  Int      @default(0) @map("expected_units")
  expectedQ      String?  @map("expected_q")
  absorptionRate Float?   @map("absorption_rate")
  supplyMonths   Float?   @map("supply_months")
  pressureScore  Float?   @map("pressure_score")
  calculatedAt   DateTime @default(now()) @map("calculated_at")

  @@unique([district])
  @@index([district])
  @@index([pressureScore])
  @@map("supply_pipeline")
}

// Spec Part 6.7 — Economic Sensitivity Score.
model MacroSensitivity {
  id           String   @id @default(cuid())
  district     String
  betaOilPrice Float?   @map("beta_oil_price")
  betaUsdAed   Float?   @map("beta_usd_aed")
  betaVix      Float?   @map("beta_vix")
  betaGdp      Float?   @map("beta_gdp")
  betaTourism  Float?   @map("beta_tourism")
  rSquared     Float?   @map("r_squared")
  calculatedAt DateTime @default(now()) @map("calculated_at")

  @@unique([district])
  @@index([district])
  @@map("macro_sensitivity")
}

// Spec Part 6.4 — Migration Signal (nationality flow).
model NationalityFlow {
  id               String   @id @default(cuid())
  nationality      String
  district         String
  month            DateTime
  transactionCount Int      @default(0) @map("transaction_count")
  totalValueAed    Float    @default(0) @map("total_value_aed")
  avgPsf           Float?   @map("avg_psf")
  shareOfTotal     Float?   @map("share_of_total")
  calculatedAt     DateTime @default(now()) @map("calculated_at")

  // Index, not unique — append-only per Task A4. Each run adds a new snapshot so
  // the flow history is preserved; readers take the newest `calculatedAt`.
  @@index([nationality, district, month])
  @@index([nationality, month])
  @@index([district, month])
  @@index([calculatedAt])
  @@map("nationality_flow")
}

// Global market summary — powers the KPI strip.
model MarketSummary {
  id                String   @id @default(cuid())
  avgPricePsfDubai  Float?   @map("avg_price_psf_dubai")
  avgPricePsfAD     Float?   @map("avg_price_psf_ad")
  totalTransactions Int?     @map("total_transactions")
  totalValueAed     Float?   @map("total_value_aed")
  avgRentalYield    Float?   @map("avg_rental_yield")
  ejariAvgYield     Float?   @map("ejari_avg_yield")
  momentumIndex     Float?   @map("momentum_index")
  transactionsDelta Float?   @map("transactions_delta")
  psfDelta          Float?   @map("psf_delta")
  yieldDelta        Float?   @map("yield_delta")
  period            String   @default("30d")
  computedAt        DateTime @default(now()) @map("computed_at")

  @@index([computedAt])
  @@map("market_summary")
}

model ExchangeRate {
  id        String   @id @default(cuid())
  base      String   @default("AED")
  usd       Float?
  gbp       Float?
  eur       Float?
  inr       Float?
  pkr       Float?
  cny       Float?
  // AED → GCC crosses, added for the `/sqftlab/exchange-rates` contract. They sit
  // alongside the five majors rather than in a separate table so one row still
  // carries a single, consistent fetchedAt for every currency in the payload.
  sar       Float?
  qar       Float?
  bhd       Float?
  kwd       Float?
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@index([fetchedAt])
  @@map("exchange_rates")
}

model MacroIndicator {
  id        String   @id @default(cuid())
  indicator String // uae_cpi | uae_gdp | oil_price | vix
  value     Float
  period    String
  source    String
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([indicator, period])
  @@index([indicator, period])
  @@map("macro_indicators")
}

model POI {
  id        String   @id @default(cuid())
  name      String
  type      String // metro | bus | school | hospital | mall | park | gym
  district  String?
  lat       Float
  lng       Float
  tags      String? // JSON-encoded
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@index([type])
  @@index([district])
  @@map("pois")
}

// Spec Part 8 — /api/img proxy cache.
model ImageCache {
  id          String    @id @default(cuid())
  externalUrl String    @unique @map("external_url")
  localPath   String?   @map("local_path")
  contentType String?   @map("content_type")
  sizeBytes   Int?      @map("size_bytes")
  fetchedAt   DateTime  @default(now()) @map("fetched_at")
  expiresAt   DateTime? @map("expires_at")

  @@map("image_cache")
}

model ScraperLog {
  id         String    @id @default(cuid())
  source     String
  status     String // running | success | error
  recordsNew Int?      @map("records_new")
  recordsUpd Int?      @map("records_upd")
  errorMsg   String?   @map("error_msg")
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  durationMs Int?      @map("duration_ms")

  @@index([source, startedAt])
  @@map("scraper_logs")
}

// One row per hourly refresh run. Without this there is no way to answer
// "is the data actually refreshing?" — the dashboard would look identical
// whether the cron ran 5 minutes ago or never.
model CronRun {
  id         String    @id @default(cuid())
  job        String // e.g. "hourly-refresh"
  status     String // running | success | partial | error
  steps      String? // JSON array: [{ step, status, ms, detail }]
  okCount    Int?      @map("ok_count")
  failCount  Int?      @map("fail_count")
  errorMsg   String?   @map("error_msg")
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  durationMs Int?      @map("duration_ms")

  @@index([job, startedAt])
  @@map("cron_runs")
}

// ═══════════════════════════════════════════════════════════════════════════
// Day 1 (Task A) — analytics, guest sessions, API keys and the auth backing
// store. Ported to SQLite: every `Json` field is TEXT holding JSON.
// ═══════════════════════════════════════════════════════════════════════════

// Every significant action, signed in or guest, for funnel analysis.
model UserEvent {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id") // null for guests
  guestId   String?  @map("guest_id") // set for guests
  eventType String   @map("event_type") // page_view | search | community_view | listing_click | sign_up | subscribe | cma_run | pdf_export | api_call | alert_created | chatbot_message
  eventData String?  @map("event_data") // JSON text: { "community": "Downtown Dubai" }
  page      String?
  referrer  String?
  userAgent String?  @map("user_agent")
  ip        String?
  sessionId String?  @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Nullable because guests have events too. SetNull (not Cascade) so that
  // deleting an account never deletes its analytics history.
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([guestId, createdAt])
  @@index([eventType, createdAt])
  @@map("user_events")
}

// Anonymous visitors. A guest that later registers is linked via
// convertedUserId, and their earlier UserEvents are re-attributed.
model GuestSession {
  id              String    @id // this IS the guestId held in the cookie
  fingerprint     String?
  referrer        String?
  utmSource       String?   @map("utm_source")
  utmMedium       String?   @map("utm_medium")
  utmCampaign     String?   @map("utm_campaign")
  pagesViewed     Int       @default(0) @map("pages_viewed")
  searchCount     Int       @default(0) @map("search_count")
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at")
  convertedAt     DateTime? @map("converted_at")
  convertedUserId String?   @map("converted_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([convertedUserId])
  @@map("guest_sessions")
}

// Developer-tier API keys. Only the SHA-256 hash is stored — never the key.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  keyHash    String    @unique @map("key_hash")
  prefix     String // first 12 chars, for display
  name       String
  tier       String    @default("pro")
  callsToday Int       @default(0) @map("calls_today")
  callsMonth Int       @default(0) @map("calls_month")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

// OAuth provider links (Google, GitHub, …).
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// Active sessions for the magic-link / OAuth flow.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Single-use email magic-link tokens.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// FEATURE-01 — the single 0–100 investment score, the product's headline number.
//
// Append-only like `district_metrics`: every run ADDS a row so the score's own
// history is preserved and never overwritten. Readers take the newest row per
// community via `latestInvestmentScores()`.
model InvestmentScore {
  id                 String    @id @default(cuid())
  communityId        String    @map("community_id")
  community          Community @relation(fields: [communityId], references: [id])
  score              Float // 0–100 weighted composite
  psfMomentum        Float?    @map("psf_momentum") // 30% weight
  rentalYield        Float?    @map("rental_yield") // 25%
  supplyAbsorption   Float?    @map("supply_absorption") // 20%
  volumeTrend        Float?    @map("volume_trend") // 15%
  capitalFlow        Float?    @map("capital_flow") // 10%
  // Share (0–1) of the five inputs that were backed by real data rather than a
  // neutral stand-in. A composite built mostly from placeholders is arithmetically
  // valid and evidentially worthless, so readers need to be able to tell them
  // apart instead of trusting every `score` equally.
  dataCoverage       Float     @default(0) @map("data_coverage")
  notes              String? // human-readable top driver, or what data is missing
  calculatedAt       DateTime  @default(now()) @map("calculated_at")

  @@index([communityId, calculatedAt])
  @@map("investment_scores")
}
